COMPARTMENT_ID=<your-compartment-id>
AUTH_PROFILE=<api-config-file-profile-used>
SERVICE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com

# Apify live mode defaults
APIFY_TOKEN=<your-apify-token>
APIFY_ACTOR=compass/crawler-google-places
APIFY_BASE_URL=https://api.apify.com
APIFY_DATA_MODE=live
DEFAULT_LOCATION=Austin, TX

# Optional debug-only static fixture mode
# APIFY_DATA_MODE=static
# APIFY_STATIC_DIR=./agent/static_data/apify
# APIFY_STATIC_FILE=default.json

APIFY_MCP_URL=https://mcp.apify.com
APIFY_MCP_TOOL=compass/crawler-google-places
APIFY_MCP_TOOLS=actors,docs,compass/crawler-google-places
APIFY_MCP_LOCAL_ENABLE=true
APIFY_MCP_LOCAL_COMMAND=npx
APIFY_MCP_LOCAL_ARGS=-y,@apify/actors-mcp-server
